generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String     // Contraseña encriptada
  rol       Rol        @default(ESTUDIANTE)
  estudiante Estudiante?
  @@map("usuarios")
}

enum Rol {
  ADMINISTRADOR
  ESTUDIANTE
}

model Estudiante {
  id        Int       @id @default(autoincrement())
  nombre    String
  email     String    @unique
  fechaNac  DateTime? @map("fecha_nac")
  usuarioId Int?      @unique @map("usuario_id")
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  inscripciones Inscripcion[]
  @@map("estudiantes")
}

model Curso {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique
  creditos     Int           @default(3)
  inscripciones Inscripcion[]
  @@map("cursos")
}

model Inscripcion {
  id            Int            @id @default(autoincrement())
  estudianteId  Int            @map("estudiante_id")
  cursoId       Int            @map("curso_id")
  fecha         DateTime       @default(now())
  estudiante    Estudiante     @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  curso         Curso          @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  calificaciones Calificacion[]
  @@unique([estudianteId, cursoId])
  @@map("inscripciones")
}

model Calificacion {
  id             Int         @id @default(autoincrement())
  inscripcionId  Int         @map("inscripcion_id")
  parcial        Int
  calificacion   Decimal     @db.Decimal(5, 2)
  inscripcion    Inscripcion @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  @@map("calificaciones")
}